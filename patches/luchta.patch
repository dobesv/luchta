@@ -0,0 +1,483 @@
+package luchta
+
+import (
+	"context"
+	"encoding/json"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func writeTsPackage(t *testing.T, dir, tsconfig, srcName, srcBody string) {
+	t.Helper()
+	mustWrite(t, filepath.Join(dir, "tsconfig.json"), tsconfig)
+	mustWrite(t, filepath.Join(dir, "src", srcName), srcBody)
+}
+
+func TestCompilePackageSuccess(t *testing.T) {
+	cwd := t.TempDir()
+	writeTsPackage(t, cwd, `{
+		"compilerOptions": {"declaration": true, "outDir": "dist", "rootDir": "src", "module": "nodenext", "moduleResolution": "nodenext"},
+		"include": ["src/**/*"]
+	}`, "index.ts", "export const answer: number = 42;\n")
+
+	res := CompilePackage(context.Background(), cwd)
+	if res.ExitCode != 0 {
+		t.Fatalf("exitCode=%d sarif=%s", res.ExitCode, DiagnosticsToSARIF(cwd, res.Diagnostics))
+	}
+	if len(res.Diagnostics) != 0 {
+		t.Fatalf("expected no diagnostics on success, got %s", DiagnosticsToSARIF(cwd, res.Diagnostics))
+	}
+	if !fileExists(filepath.Join(cwd, "dist", "index.js")) {
+		t.Fatalf("expected dist/index.js emitted; outputs=%v", res.Outputs)
+	}
+	if !slices.Contains(res.Outputs, "dist/index.js") {
+		t.Fatalf("outputs missing dist/index.js: %v", res.Outputs)
+	}
+}
+
+func TestCompilePackageRemovesStaleDeclaration(t *testing.T) {
+	cwd := t.TempDir()
+	writeTsPackage(t, cwd, `{
+		"compilerOptions": {"declaration": true, "outDir": "dist", "rootDir": "src"},
+		"include": ["src/**/*"]
+	}`, "index.ts", "export const answer = 42;\n")
+	stale := filepath.Join(cwd, "dist", "gone.d.ts")
+	mustWrite(t, stale, "export declare const gone: number;")
+
+	res := CompilePackage(context.Background(), cwd)
+	if res.ExitCode != 0 {
+		t.Fatalf("exitCode=%d internalError=%q sarif=%s", res.ExitCode, res.InternalError, DiagnosticsToSARIF(cwd, res.Diagnostics))
+	}
+	if fileExists(stale) {
+		t.Fatalf("stale declaration survived CompilePackage: %s", stale)
+	}
+}
+
+func TestCompilePackageCleansDeclarationDir(t *testing.T) {
+	cwd := t.TempDir()
+	writeTsPackage(t, cwd, `{
+		"compilerOptions": {"declaration": true, "outDir": "dist/js", "declarationDir": "dist/types", "rootDir": "src"},
+		"include": ["src/**/*"]
+	}`, "index.ts", "export const answer = 42;\n")
+	stale := filepath.Join(cwd, "dist", "types", "gone.d.ts")
+	mustWrite(t, stale, "export declare const gone: number;")
+
+	res := CompilePackage(context.Background(), cwd)
+	if res.ExitCode != 0 {
+		t.Fatalf("exitCode=%d internalError=%q sarif=%s", res.ExitCode, res.InternalError, DiagnosticsToSARIF(cwd, res.Diagnostics))
+	}
+	if fileExists(stale) {
+		t.Fatalf("stale declaration in declarationDir survived: %s", stale)
+	}
+	if !fileExists(filepath.Join(cwd, "dist", "types", "index.d.ts")) {
+		t.Fatal("expected declaration emit under declarationDir")
+	}
+}
+
+func TestCompilePackageRejectsEscapingCleanDirectory(t *testing.T) {
+	tests := []struct {
+		name    string
+		options string
+		inside  string
+	}{
+		{
+			name:    "outDir",
+			options: `{"declaration":true,"outDir":"../../dist","rootDir":"src"}`,
+		},
+		{
+			name:    "declarationDir",
+			options: `{"declaration":true,"outDir":"dist/js","declarationDir":"../../dist","rootDir":"src"}`,
+			inside:  "dist/js/gone.d.ts",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			root := t.TempDir()
+			cwd := filepath.Join(root, "packages", "pkg")
+			writeTsPackage(t, cwd, `{"compilerOptions":`+tt.options+`,"include":["src/**/*"]}`,
+				"index.ts", "export const answer = 42;\n")
+			outside := filepath.Join(root, "dist", "gone.d.ts")
+			mustWrite(t, outside, "export declare const gone: number;")
+			if tt.inside != "" {
+				mustWrite(t, filepath.Join(cwd, filepath.FromSlash(tt.inside)), "export declare const gone: number;")
+			}
+
+			res := CompilePackage(context.Background(), cwd)
+			if res.ExitCode == 0 || !strings.Contains(res.InternalError, "outside package") {
+				t.Fatalf("expected cleanup-boundary error, exitCode=%d internalError=%q", res.ExitCode, res.InternalError)
+			}
+			if !fileExists(outside) {
+				t.Fatalf("cleanup deleted file outside package: %s", outside)
+			}
+			if tt.inside != "" && !fileExists(filepath.Join(cwd, filepath.FromSlash(tt.inside))) {
+				t.Fatal("cleanup fell back from declarationDir to outDir")
+			}
+		})
+	}
+}
+
+func TestCompilePackageUsesConfigDirAsSourceRootWhenRootDirOmitted(t *testing.T) {
+	cwd := t.TempDir()
+	mustWrite(t, filepath.Join(cwd, "tsconfig.json"), `{
+		"compilerOptions": {"outDir": "dist"},
+		"include": ["*.ts"]
+	}`)
+	mustWrite(t, filepath.Join(cwd, "index.ts"), "export const answer = 42;\n")
+	declaration := filepath.Join(cwd, "dist", "index.d.ts")
+	mustWrite(t, declaration, "export declare const answer: number;")
+
+	res := CompilePackage(context.Background(), cwd)
+	if res.ExitCode != 0 {
+		t.Fatalf("exitCode=%d internalError=%q sarif=%s", res.ExitCode, res.InternalError, DiagnosticsToSARIF(cwd, res.Diagnostics))
+	}
+	if !fileExists(declaration) {
+		t.Fatal("cleanup removed declaration whose source exists beside tsconfig")
+	}
+}
+
+func TestCompilePackageTypeError(t *testing.T) {
+	repoRoot := t.TempDir()
+	cwd := filepath.Join(repoRoot, "packages", "pkg")
+	writeTsPackage(t, cwd, `{
+		"compilerOptions": {"outDir": "dist", "rootDir": "src", "module": "nodenext", "moduleResolution": "nodenext", "strict": true}
+	}`, "index.ts", "export const answer: number = \"not a number\";\n")
+
+	res := CompilePackage(context.Background(), cwd)
+	if res.ExitCode == 0 {
+		t.Fatalf("expected non-zero exit on type error")
+	}
+	if len(res.Diagnostics) == 0 {
+		t.Fatalf("expected diagnostics")
+	}
+
+	// The worker reports diagnostics as a SARIF document; verify it is
+	// well-formed and carries the error with a clickable location.
+	var log sarifLog
+	if err := json.Unmarshal([]byte(DiagnosticsToSARIF(repoRoot, res.Diagnostics)), &log); err != nil {
+		t.Fatalf("invalid SARIF: %v", err)
+	}
+	if len(log.Runs) == 0 || len(log.Runs[0].Results) == 0 {
+		t.Fatalf("SARIF missing results")
+	}
+	result := log.Runs[0].Results[0]
+	if result.RuleID == "" {
+		t.Fatalf("missing ruleId")
+	}
+	if len(result.Locations) == 0 {
+		t.Fatalf("missing location")
+	}
+	loc := result.Locations[0]
+	uri := loc.PhysicalLocation.ArtifactLocation.URI
+	if uri == "" {
+		t.Fatalf("missing artifact URI")
+	}
+	if filepath.IsAbs(uri) {
+		t.Fatalf("artifact URI must be repo-relative, got absolute path %q", uri)
+	}
+	if want := filepath.ToSlash(filepath.Join("packages", "pkg", "src", "index.ts")); uri != want {
+		t.Fatalf("artifact URI = %q, want repo-relative %q", uri, want)
+	}
+}
+
+func TestRepoRelativeSARIFURI(t *testing.T) {
+	base := t.TempDir()
+	repoRoot := filepath.Join(base, "repo")
+	outsideRoot := filepath.Join(base, "other")
+
+	tests := []struct {
+		name     string
+		repoRoot string
+		absPath  string
+		want     string
+	}{
+		{
+			name:    "in repo strips root prefix",
+			absPath: filepath.Join(repoRoot, "packages", "app", "src", "foo.ts"),
+			want:    filepath.ToSlash(filepath.Join("packages", "app", "src", "foo.ts")),
+		},
+		{
+			name:    "outside repo falls back to full path",
+			absPath: filepath.Join(outsideRoot, "src", "foo.ts"),
+			want:    filepath.ToSlash(filepath.Join(outsideRoot, "src", "foo.ts")),
+		},
+		{
+			name:    "repo root itself returns dot",
+			absPath: repoRoot,
+			want:    ".",
+		},
+		{
+			name:    "dot dot prefix segment stays relative",
+			absPath: filepath.Join(repoRoot, "..config", "foo.ts"),
+			want:    filepath.ToSlash(filepath.Join("..config", "foo.ts")),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			repo := tt.repoRoot
+			if repo == "" {
+				repo = repoRoot
+			}
+			if got := repoRelativeSARIFURI(repo, tt.absPath); got != tt.want {
+				t.Fatalf("repoRelativeSARIFURI(%q, %q) = %q, want %q", repo, tt.absPath, got, tt.want)
+			}
+		})
+	}
+}

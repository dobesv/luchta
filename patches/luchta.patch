+			}]]],
+			["app", [["workspace:packages/app", {
+				"packageLocation": "./packages/app/",
+				"packageDependencies": [
+					["app", "workspace:packages/app"],
+					["@company/tsconfig-base", "workspace:packages/tsconfig-base"]
+				],
+				"linkType": "SOFT"
+			}]]],
+			["@company/tsconfig-base", [["workspace:packages/tsconfig-base", {
+				"packageLocation": "./packages/tsconfig-base/",
+				"packageDependencies": [
+					["@company/tsconfig-base", "workspace:packages/tsconfig-base"]
+				],
+				"linkType": "SOFT"
+			}]]]
+		]
+	}`)
+	mustWrite(t, filepath.Join(base, "strict.json"), `{"include":["shared/**/*.ts"]}`)
+	mustWrite(t, filepath.Join(base, "shared", "existing.ts"), "export const shared = true;\n")
+	mustWrite(t, filepath.Join(app, "tsconfig.json"), `{
+		"extends": "@company/tsconfig-base/strict.json",
+		"compilerOptions": {"outDir": "dist"}
+	}`)
+
+	inputs, err := ResolveInputs(app)
+	if err != nil {
+		t.Fatalf("ResolveInputs: %v", err)
+	}
+	if want := "../tsconfig-base/shared/**/*.ts"; !slices.Contains(inputs, want) {
+		t.Fatalf("inputs missing inherited PnP include %q: %v", want, inputs)
+	}
+}

+
+func TestRelativizeOutputs(t *testing.T) {
+	got := RelativizeOutputs("/repo/pkg", []string{"/repo/pkg/dist/a.js", "/repo/pkg/dist/types/a.d.ts"})
+	want := []string{"dist/a.js", "dist/types/a.d.ts"}
+	if len(got) != 2 || got[0] != want[0] || got[1] != want[1] {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestCleanOutputsRemovesStaleDts(t *testing.T) {
+	cwd := t.TempDir()
+	mustWrite(t, filepath.Join(cwd, "src", "keep.ts"), "export const x = 1;")
+	mustWrite(t, filepath.Join(cwd, "dist/types", "keep.d.ts"), "export declare const x: number;")
+	mustWrite(t, filepath.Join(cwd, "dist/types", "keep.d.ts.map"), "{}")
+	mustWrite(t, filepath.Join(cwd, "dist/types", "gone.d.ts"), "export declare const y: number;")
+	mustWrite(t, filepath.Join(cwd, "dist/types", "gone.d.ts.map"), "{}")
+
+	if err := CleanOutputs(cwd, filepath.Join(cwd, "dist/types"), filepath.Join(cwd, "src"), false); err != nil {
+		t.Fatalf("CleanOutputs: %v", err)
+	}
+	got := listFiles(t, filepath.Join(cwd, "dist/types"))
+	want := []string{"keep.d.ts", "keep.d.ts.map"}
+	if len(got) != len(want) || got[0] != want[0] || got[1] != want[1] {
+		t.Fatalf("got %v want %v", got, want)
+	}
+}
+
+func TestCleanOutputsPreservesAllowJSSources(t *testing.T) {
+	cwd := t.TempDir()
+	sourceRoot := filepath.Join(cwd, "src")
+	cleanDir := filepath.Join(cwd, "dist", "types")
+	for _, fixture := range []struct {
+		stem      string
+		extension string
+	}{
+		{stem: "from-js", extension: ".js"},
+		{stem: "from-jsx", extension: ".jsx"},
+	} {
+		mustWrite(t, filepath.Join(sourceRoot, fixture.stem+fixture.extension), "export const value = 1;")
+		mustWrite(t, filepath.Join(cleanDir, fixture.stem+".d.ts"), "export declare const value: number;")
+		mustWrite(t, filepath.Join(cleanDir, fixture.stem+".d.ts.map"), "{}")
+	}
+
+	if err := CleanOutputs(cwd, cleanDir, sourceRoot, false); err != nil {
+		t.Fatalf("CleanOutputs: %v", err)
+	}
+	for _, name := range []string{"from-js.d.ts", "from-js.d.ts.map", "from-jsx.d.ts", "from-jsx.d.ts.map"} {
+		if !fileExists(filepath.Join(cleanDir, name)) {
+			t.Fatalf("declaration for allowJs source was removed: %s", name)
+		}
+	}
+}
+
+func TestCleanOutputsHandlesModuleDeclarationExtensions(t *testing.T) {
+	cwd := t.TempDir()
+	sourceRoot := filepath.Join(cwd, "src")
+	cleanDir := filepath.Join(cwd, "dist", "types")
+	mustWrite(t, filepath.Join(sourceRoot, "live-esm.mts"), "export const value = 1;")
+	mustWrite(t, filepath.Join(sourceRoot, "live-esm-js.mjs"), "export const value = 1;")
+	mustWrite(t, filepath.Join(sourceRoot, "live-cjs.cts"), "export const value = 1;")
+	mustWrite(t, filepath.Join(sourceRoot, "live-cjs-js.cjs"), "export const value = 1;")
+	for _, name := range []string{
+		"live-esm.d.mts", "live-esm.d.mts.map", "live-esm-js.d.mts", "live-esm-js.d.mts.map", "gone-esm.d.mts", "gone-esm.d.mts.map",
+		"live-cjs.d.cts", "live-cjs.d.cts.map", "live-cjs-js.d.cts", "live-cjs-js.d.cts.map", "gone-cjs.d.cts", "gone-cjs.d.cts.map",
+	} {
+		mustWrite(t, filepath.Join(cleanDir, name), "declaration")
+	}
+
+	if err := CleanOutputs(cwd, cleanDir, sourceRoot, false); err != nil {
+		t.Fatalf("CleanOutputs: %v", err)
+	}
+	got := listFiles(t, cleanDir)
+	want := []string{
+		"live-cjs-js.d.cts", "live-cjs-js.d.cts.map", "live-cjs.d.cts", "live-cjs.d.cts.map",
+		"live-esm-js.d.mts", "live-esm-js.d.mts.map", "live-esm.d.mts", "live-esm.d.mts.map",
+	}
+	if len(got) != len(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("got %v want %v", got, want)
+		}
+	}
+}
+
+func TestCleanOutputsSkipsWhenNoEmit(t *testing.T) {
+	cwd := t.TempDir()
+	mustWrite(t, filepath.Join(cwd, "dist/types", "gone.d.ts"), "x")
+	if err := CleanOutputs(cwd, filepath.Join(cwd, "dist/types"), filepath.Join(cwd, "src"), true); err != nil {
+		t.Fatalf("CleanOutputs: %v", err)
+	}

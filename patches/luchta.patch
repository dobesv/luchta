diff --git a/tsc/internal/pnp/pnp.go b/tsc/internal/pnp/pnp.go
index a05eea216e..e78cf34109 100644
--- a/tsc/internal/pnp/pnp.go
+++ b/tsc/internal/pnp/pnp.go
@@ -1,8 +1,12 @@
 package pnp
 
 import (
+	"os"
 	"strings"
+	"sync"
+	"time"
 
+	"github.com/microsoft/TypeScript/tsc/internal/tspath"
 	"github.com/microsoft/TypeScript/tsc/internal/vfs"
 )
 
@@ -18,6 +22,89 @@ func InitPnpApi(fs vfs.FS, filePath string) *PnpApi {
 	return nil
 }
 
+// fileIdentity captures the on-disk identity of a manifest source file so a
+// cached parse can be validated without re-reading the file.
+type fileIdentity struct {
+	exists  bool
+	size    int64
+	modTime time.Time
+}
+
+func identityOf(path string) fileIdentity {
+	info, err := os.Stat(path)
+	if err != nil {
+		return fileIdentity{}
+	}
+	return fileIdentity{exists: true, size: info.Size(), modTime: info.ModTime()}
+}
+
+type cachedManifest struct {
+	manifest *PnpManifestData
+	// parseManifestFromPath reads .pnp.data.json when present, otherwise the
+	// data blob embedded in .pnp.cjs — so both identities gate reuse.
+	cjs  fileIdentity
+	data fileIdentity
+}
+
+var manifestCache sync.Map // manifest dir (normalized) -> *cachedManifest
+
+// InitPnpApiCached is InitPnpApi backed by a process-wide cache of parsed
+// manifests, for long-lived processes that compile many packages under one
+// workspace. The workspace .pnp.cjs is multiple MB and parsing it costs tens
+// of milliseconds; without the cache every compilation pays that again.
+// A cached manifest is reused only while the size and mtime of .pnp.cjs and
+// .pnp.data.json are unchanged, so manifest rewrites (e.g. yarn install
+// during watch) are picked up.
+//
+// The returned PnpApi shares the cached manifest with other callers and must
+// be treated as read-only; do not call RefreshManifest on it.
+func InitPnpApiCached(fs vfs.FS, filePath string) *PnpApi {
+	manifestDir := findClosestPnpManifestDir(fs, filePath)
+	if manifestDir == "" {
+		return nil
+	}
+
+	cjs := identityOf(tspath.CombinePaths(manifestDir, ".pnp.cjs"))
+	if !cjs.exists {
+		// FileExists saw the manifest but os.Stat cannot (e.g. a virtual test
+		// FS); fall back to the uncached path.
+		return InitPnpApi(fs, filePath)
+	}
+	data := identityOf(tspath.CombinePaths(manifestDir, ".pnp.data.json"))
+
+	if value, ok := manifestCache.Load(manifestDir); ok {
+		cached := value.(*cachedManifest)
+		if cached.cjs == cjs && cached.data == data {
+			return &PnpApi{fs: fs, url: filePath, manifest: cached.manifest}
+		}
+	}
+
+	manifest, err := parseManifestFromPath(fs, manifestDir)
+	if err != nil {
+		return nil
+	}
+	manifestCache.Store(manifestDir, &cachedManifest{manifest: manifest, cjs: cjs, data: data})
+	return &PnpApi{fs: fs, url: filePath, manifest: manifest}
+}
+
+// findClosestPnpManifestDir walks up from filePath and returns the first
+// directory containing a .pnp.cjs manifest, or "" when there is none.
+func findClosestPnpManifestDir(fs vfs.FS, filePath string) string {
+	directoryPath := tspath.GetNormalizedAbsolutePath(filePath, "/")
+
+	for {
+		if fs.FileExists(tspath.CombinePaths(directoryPath, ".pnp.cjs")) {
+			return directoryPath
+		}
+
+		if tspath.IsDiskPathRoot(directoryPath) {
+			return ""
+		}
+
+		directoryPath = tspath.GetDirectoryPath(directoryPath)
+	}
+}
+
 func IsPnpLoaderFile(path string) bool {
 	return strings.HasSuffix(path, ".pnp.cjs")
 }

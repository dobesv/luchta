+		t.Fatalf("noEmit should leave files untouched: %v", err)
+	}
+}
+
+func TestCleanOutputsRejectsOutsideMissingDirectory(t *testing.T) {
+	root := t.TempDir()
+	cwd := filepath.Join(root, "packages", "pkg")
+	if err := os.MkdirAll(cwd, 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	err := CleanOutputs(cwd, filepath.Join(root, "dist"), filepath.Join(cwd, "src"), false)
+	if err == nil {
+		t.Fatal("CleanOutputs accepted an output directory outside the package")
+	}
+}
+
+func TestCleanOutputsRejectsIntermediateSymlinkEscape(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlink creation requires elevated privileges on Windows")
+	}
+
+	root := t.TempDir()
+	cwd := filepath.Join(root, "pkg")
+	outsideDir := filepath.Join(root, "outside")
+	if err := os.MkdirAll(filepath.Join(cwd, "build"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(outsideDir, "types"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outsideDir, filepath.Join(cwd, "build", "link")); err != nil {
+		t.Fatal(err)
+	}
+	declaration := filepath.Join(outsideDir, "types", "gone.d.ts")
+	declarationMap := declaration + ".map"
+	mustWrite(t, declaration, "export declare const gone: number;")
+	mustWrite(t, declarationMap, "{}")
+
+	cleanDir := filepath.Join(cwd, "build", "link", "types")
+	if err := CleanOutputs(cwd, cleanDir, filepath.Join(cwd, "src"), false); err == nil {
+		t.Fatal("CleanOutputs accepted a directory escaping through an intermediate symlink")
+	}
+	for _, path := range []string{declaration, declarationMap} {
+		if !fileExists(path) {
+			t.Fatalf("CleanOutputs deleted file outside package: %s", path)
+		}
+	}
+}
+
+func TestCleanOutputsDoesNotDeleteWhenSourceStatFails(t *testing.T) {
+	cwd := t.TempDir()
+	sourceRoot := filepath.Join(cwd, "src")
+	cleanDir := filepath.Join(cwd, "dist", "types")
+	mustWrite(t, filepath.Join(sourceRoot, "nested"), "not a directory")
+	declaration := filepath.Join(cleanDir, "nested", "gone.d.ts")
+	mustWrite(t, declaration, "export declare const gone: number;")
+
+	if err := CleanOutputs(cwd, cleanDir, sourceRoot, false); err == nil {
+		t.Fatal("CleanOutputs returned nil after source stat failed")
+	}
+	if !fileExists(declaration) {
+		t.Fatal("CleanOutputs deleted declaration after an inconclusive source stat")
+	}
+}
+
+func mustWrite(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func listFiles(t *testing.T, dir string) []string {
+	t.Helper()
+	var out []string
+	_ = filepath.WalkDir(dir, func(p string, d os.DirEntry, err error) error {
+		if err == nil && !d.IsDir() {
+			rel, _ := filepath.Rel(dir, p)
+			out = append(out, rel)
+		}
+		return nil
+	})
+	sort.Strings(out)
+	return out
+}

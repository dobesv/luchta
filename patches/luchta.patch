index 0000000000..86965cfae6
--- /dev/null
+++ b/tsc/internal/luchta/outputs.go
@@ -0,0 +1,139 @@
+package luchta
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/microsoft/TypeScript/tsc/internal/tspath"
+)
+
+const sourceMapExtension = ".map"
+
+// RelativizeOutputs makes absolute output paths relative to cwd (forward slashes).
+func RelativizeOutputs(cwd string, outputs []string) []string {
+	out := make([]string, 0, len(outputs))
+	for _, o := range outputs {
+		rel, err := filepath.Rel(cwd, o)
+		if err != nil {
+			rel = o
+		}
+		out = append(out, filepath.ToSlash(rel))
+	}
+	return out
+}
+
+// CleanOutputs removes declaration files and declaration maps under cleanDir
+// whose originating source file under sourceRoot no longer exists. All
+// directories are absolute. No-op when noEmit is true or cleanDir is absent.
+func CleanOutputs(cwd, cleanDir, sourceRoot string, noEmit bool) error {
+	if noEmit {
+		return nil
+	}
+
+	resolvedCwd, err := filepath.EvalSymlinks(cwd)
+	if err != nil {
+		return fmt.Errorf("resolve package directory %q: %w", cwd, err)
+	}
+	resolvedCleanDir, cleanDirExists, err := resolveCleanDir(cleanDir)
+	if err != nil {
+		return err
+	}
+	if err := ensureLocalCleanDir(resolvedCwd, resolvedCleanDir); err != nil {
+		return err
+	}
+	if !cleanDirExists {
+		return nil
+	}
+
+	return filepath.WalkDir(resolvedCleanDir, func(path string, d os.DirEntry, err error) error {
+		if err != nil || d.IsDir() {
+			return err
+		}
+
+		declarationPath := path
+		if strings.HasSuffix(declarationPath, sourceMapExtension) {
+			declarationPath = strings.TrimSuffix(declarationPath, sourceMapExtension)
+		}
+		if !tspath.FileExtensionIsOneOf(declarationPath, tspath.SupportedDeclarationExtensions) {
+			return nil
+		}
+
+		declarationExtension := tspath.GetDeclarationFileExtension(declarationPath)
+		stemPath := strings.TrimSuffix(declarationPath, declarationExtension)
+		rel, err := filepath.Rel(resolvedCleanDir, stemPath)
+		if err != nil {
+			return err
+		}
+		for _, extension := range tspath.GetPossibleOriginalInputExtensionForExtension(declarationPath) {
+			exists, err := sourceFileExists(filepath.Join(sourceRoot, rel+extension))
+			if err != nil {
+				return err
+			}
+			if exists {
+				return nil
+			}
+		}
+		return os.Remove(path)
+	})
+}
+
+func resolveCleanDir(cleanDir string) (resolved string, exists bool, err error) {
+	resolved, err = filepath.EvalSymlinks(cleanDir)
+	if err == nil {
+		return resolved, true, nil
+	}
+	if !os.IsNotExist(err) {
+		return "", false, fmt.Errorf("resolve output directory %q: %w", cleanDir, err)
+	}
+
+	ancestor := cleanDir
+	var suffix []string
+	for {
+		parent := filepath.Dir(ancestor)
+		if parent == ancestor {
+			return "", false, fmt.Errorf("resolve output directory %q: %w", cleanDir, err)
+		}
+		suffix = append(suffix, filepath.Base(ancestor))
+		ancestor = parent
+		resolvedAncestor, ancestorErr := filepath.EvalSymlinks(ancestor)
+		if ancestorErr == nil {
+			resolved = resolvedAncestor
+			for i := len(suffix) - 1; i >= 0; i-- {
+				resolved = filepath.Join(resolved, suffix[i])
+			}
+			return resolved, false, nil
+		}
+		if !os.IsNotExist(ancestorErr) {
+			return "", false, fmt.Errorf("resolve output directory ancestor %q: %w", ancestor, ancestorErr)
+		}
+	}
+}
+
+func ensureLocalCleanDir(cwd, cleanDir string) error {
+	relCleanDir, err := filepath.Rel(cwd, cleanDir)
+	if err != nil {
+		return fmt.Errorf("determine cleanup boundary for %q: %w", cleanDir, err)
+	}
+	if !filepath.IsLocal(relCleanDir) {
+		return fmt.Errorf("refusing to clean output directory %q outside package %q", cleanDir, cwd)
+	}
+	return nil
+}
+
+func sourceFileExists(path string) (bool, error) {
+	_, err := os.Stat(path)
+	if err == nil {
+		return true, nil
+	}
+	if os.IsNotExist(err) {
+		return false, nil
+	}
+	return false, err
+}
+
+func fileExists(path string) bool {
+	_, err := os.Stat(path)
+	return err == nil
+}

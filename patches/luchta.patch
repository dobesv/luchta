+package pnp
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/microsoft/TypeScript/tsc/internal/repo"
+	"github.com/microsoft/TypeScript/tsc/internal/vfs/osvfs"
+)
+
+func writeFixtureManifest(t *testing.T, dir string) {
+	t.Helper()
+	fixture := filepath.Join(repo.TestDataPath(), "fixtures", "pnp", "pnp-yarn-v4.cjs")
+	content, err := os.ReadFile(fixture)
+	if err != nil {
+		t.Fatalf("read fixture: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, ".pnp.cjs"), content, 0o644); err != nil {
+		t.Fatalf("write manifest: %v", err)
+	}
+}
+
+func TestInitPnpApiCachedReusesParsedManifest(t *testing.T) {
+	t.Parallel()
+	root := t.TempDir()
+	writeFixtureManifest(t, root)
+	pkg := filepath.Join(root, "packages", "app")
+	if err := os.MkdirAll(pkg, 0o755); err != nil {
+		t.Fatalf("mkdir: %v", err)
+	}
+
+	first := InitPnpApiCached(osvfs.FS(), pkg)
+	if first == nil {
+		t.Fatal("expected PnpApi for workspace with .pnp.cjs")
+	}
+	second := InitPnpApiCached(osvfs.FS(), root)
+	if second == nil {
+		t.Fatal("expected PnpApi on second lookup")
+	}
+	if first.manifest != second.manifest {
+		t.Fatal("expected cached manifest to be reused while file is unchanged")
+	}
+}
+
+func TestInitPnpApiCachedReparsesWhenManifestChanges(t *testing.T) {
+	t.Parallel()
+	root := t.TempDir()
+	writeFixtureManifest(t, root)
+
+	first := InitPnpApiCached(osvfs.FS(), root)
+	if first == nil {
+		t.Fatal("expected PnpApi for workspace with .pnp.cjs")
+	}
+
+	// Force a different mtime; same-instant rewrites could otherwise be
+	// indistinguishable on coarse-timestamp filesystems.
+	manifestPath := filepath.Join(root, ".pnp.cjs")
+	newTime := time.Now().Add(2 * time.Second)
+	if err := os.Chtimes(manifestPath, newTime, newTime); err != nil {
+		t.Fatalf("chtimes: %v", err)
+	}
+
+	second := InitPnpApiCached(osvfs.FS(), root)
+	if second == nil {
+		t.Fatal("expected PnpApi after manifest touch")
+	}
+	if first.manifest == second.manifest {
+		t.Fatal("expected manifest to be re-parsed after mtime change")
+	}
+}
+
+func TestInitPnpApiCachedReturnsNilWithoutManifest(t *testing.T) {
+	t.Parallel()
+	if api := InitPnpApiCached(osvfs.FS(), t.TempDir()); api != nil {
+		t.Fatal("expected nil PnpApi when no .pnp.cjs exists")
+	}
+}
